# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# NOTE: with serverless Postgres (Neon/Supabase), the app must use the DIRECT
# (non-pooled) endpoint — Prisma interactive transactions fail over a PgBouncer
# pooler. The pooled ("-pooler") host is fine for running migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maintenance_db?schema=public"

# CORS — comma-separated list of allowed origins, or * for any.
# For web + mobile clients, list your frontends e.g.:
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Maintenance domain business rules ("decisions to lock in")
AUTO_CLOSE_DAYS=3          # days after `resolved` before an issue auto-closes
FAULTY_THRESHOLD=3         # consecutive not_working logs before device -> faulty
CASCADING_VISIBILITY=false # parent-zone incharge sees sub-zone data?
INCHARGE_CAN_REASSIGN=false # can a zone incharge reassign a technician?

# Auth — generate strong secrets in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10
